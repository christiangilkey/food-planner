<?xml version="1.0" encoding="utf-8"?>
<!-- Only what the app shares with other apps: the camera's temporary label photo (in the app's own
     folder, deleted after it's read) and a backup file in the app's cache. Nothing else on the phone. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-files-path name="camera" path="Pictures/" />
    <cache-path name="cache" path="." />
</paths>
